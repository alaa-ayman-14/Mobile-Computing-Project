<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:background="@color/surface">


    <ImageView
        android:id="@+id/ivFavoriteBookImage"
        android:layout_width="90dp"
        android:layout_height="120dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_book_placeholder"
        android:scaleType="fitCenter"
        android:contentDescription="@string/book_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <TextView
        android:id="@+id/tvFavoriteBookTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="start"
        tools:text="The Great Gatsby"
        app:layout_constraintStart_toEndOf="@id/ivFavoriteBookImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivFavoriteBookImage" />

    <TextView
        android:id="@+id/tvFavoriteBookAuthor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="F. Scott Fitzgerald"
        app:layout_constraintStart_toEndOf="@id/ivFavoriteBookImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFavoriteBookTitle" />

    <TextView
        android:id="@+id/tvFavoriteBookPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        tools:text="250.00 EGP"
        app:layout_constraintStart_toEndOf="@id/ivFavoriteBookImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFavoriteBookAuthor" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveFavorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:text="@string/remove_favorite"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp"
        app:layout_constraintStart_toEndOf="@id/ivFavoriteBookImage"
        app:layout_constraintTop_toBottomOf="@id/tvFavoriteBookPrice" />



</androidx.constraintlayout.widget.ConstraintLayout>