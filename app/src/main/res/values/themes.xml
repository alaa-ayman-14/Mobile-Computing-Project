        <item name="windowSplashScreenBackground">@color/background</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_book_splash</item>

        <item name="postSplashScreenTheme">@style/Theme.BookStore</item>

    </style>

</resources>